reset;
model MRP.mod;

let PERIODS := 1..12; 

# 1. Products
table tbl_Product IN 'odbc' "Database.accdb" "Product":
    PRODUCTS <- [ProductID], LTPP;
read table tbl_Product;

# 2. Components
table tbl_Component IN 'odbc' "Database.accdb" "Component":
    COMPONENTS <- [ComponentID], PcsPerBox, BoxWeight, UnitWeight, MagInit;
read table tbl_Component;

# 3. Suppliers
table tbl_Supplier IN 'odbc' "Database.accdb" "Supplier":
    SUPPLIERS <- [SupplierID], Distance;
read table tbl_Supplier;

# 4. Bill of materials (BOM)
table tbl_BOM IN 'odbc' "Database.accdb" "BOM":
    BOM <- [AssemblyID, ComponentID], nProdComp;
read table tbl_BOM;

# 5. Supplier catalogue and prices
table tbl_CompSupp IN 'odbc' "Database.accdb" "CompSupp":
    COMP_SUPP <- [ComponentID, SupplierID], CostOfBox;
read table tbl_CompSupp;

# MASTER PLAN (MPS_Plan)
# Read the MPS results table to get the quantities to produce (X)
table tbl_MPS IN 'odbc' "Database.accdb" "MPS_Table":
    [ProductID, Period], MPS_Plan ~ X; 
read table tbl_MPS;

# SOLUTION
option solver gurobi;
solve;

display Total_MRP_Cost;
display GrossReq; # Gross requirements generated by the MPS

# Decisions of the solver
#display Y;          # Months in which a truck is ordered from each supplier (1 or 0)
display RO_Comp;    # Components ordered (a multiple of the pieces per box)
display ArrivalQty; # Components arriving in month t
display Inv;        # Inventory at the end of month t
display NumBoxes;   # Number of whole boxes ordered

#display HoldingCostComp;
display SetupOrderCost; 
display MagInit;
